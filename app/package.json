{
  "name": "web-application-project",
  "version": "0.2.0",
  "description": "RedwoodSDK-grunnlag for ITF31619",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-dev-vars.mjs && node scripts/copy-flags.mjs && vite dev --host 127.0.0.1",
    "build": "node scripts/copy-flags.mjs && vite build",
    "preview": "node scripts/ensure-dev-vars.mjs && vite preview --host 127.0.0.1",
    "generate": "wrangler types --include-runtime false",
    "typecheck": "node scripts/ensure-dev-vars.mjs && npm run generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:check": "wrangler d1 execute DB --local --command \"SELECT 1 AS ok\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run db:check && npm run db:migrate:local && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "circle-flags": "2.8.3",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "1.13.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "rwsdk": "1.7.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20260920.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "5.0.1",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "~8.2.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true
  }
}
